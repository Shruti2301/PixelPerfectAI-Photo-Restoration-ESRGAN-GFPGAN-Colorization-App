# =============================================================================
# --- CRITICAL VARIABLES ---
# =============================================================================
# This file contains all essential environment variables required for the 
# server, authentication, database, AI services, and payment integration.
# Always keep this file secure and never commit it to a public repository.
# =============================================================================

# =============================================================================
# --- SERVER CONFIGURATION ---
# =============================================================================
PORT=5001

# =============================================================================
# --- DATABASE CONFIGURATION ---
# =============================================================================
# PostgreSQL / Neon database connection string.
# Replace with your actual database credentials locally.
DATABASE_URL="your_postgresql_database_url_here"

# Optional individual PostgreSQL variables
PGDATABASE="your_database_name"
PGHOST="your_database_host"
PGPORT="5432"
PGUSER="your_database_user"
PGPASSWORD="your_database_password"

# =============================================================================
# --- SESSION / AUTH ---
# =============================================================================
# Secret key used for session encryption.
SESSION_SECRET="your_session_secret_here"

# =============================================================================
# --- THIRD-PARTY SERVICES ---
# =============================================================================
# Replicate API token
REPLICATE_API_TOKEN="your_replicate_api_token_here"

# =============================================================================
# --- REPLIT AUTH VARIABLES ---
# =============================================================================
REPLIT_DOMAINS="localhost"

# Your Replit app client ID
REPL_ID="your_replit_app_id"

# Replit OIDC issuer URL
ISSUER_URL="https://replit.com/oidc"
