# =============================================================================
# --- SERVER CONFIGURATION ---
# =============================================================================
# The port on which the Express server will run.
# Default 5000 might conflict with other services, so we use 5001.
PORT=5001

# PostgreSQL / Neon database connection string.
# Used by Drizzle ORM and the backend to access user, enhancements, and analytics data.
# Make sure SSL mode and channel binding settings match your Neon configuration.
export DATABASE_URL="postgresql://neondb_owner:npg_E0h7WqFCeVnA@ep-nameless-frog-ahds3ov3-pooler.c-3.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DATABASE_URL="postgresql://neondb_owner:npg_E0h7WqFCeVnA@ep-nameless-frog-ahds3ov3-pooler.c-3.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Secret key used to encrypt session cookies and manage server-side sessions.
# Make sure to copy the full long value. Never share this publicly.
SESSION_SECRET="XZtn1yfhn5G6CHgQ1YNwBTwnf+p3AR4jY4S9rNH7nGaIUp16DqZGVB8Bc7h72o..." 

# Optional: individual database components for tools that parse them separately.
# Usually DATABASE_URL is sufficient, but these are helpful for debugging.
PGDATABASE="neondb"
PGHOST="ep-curly-salad-ag4gbpxo.c-2.eu-central-1.aws.neon.tech"
PGPORT="5432"
PGUSER="neondb_owner"
PGPASSWORD="npg_Wtd1fIXKjgq7"

