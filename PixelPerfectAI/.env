REPLICATE_API_TOKEN="r8_N79C0MUThpDg4p3SCi6uXRY05QFmBle2ke0Df"

# =============================================================================
# --- REPLIT AUTH VARIABLES ---
# =============================================================================
# Required for Replit OAuth authentication even in local development.
# For local dev, set REPLIT_DOMAINS to localhost.
REPLIT_DOMAINS="localhost"

# Your Replit app client ID (replace with your actual ID).
REPL_ID="12345"

# The issuer URL for Replit OIDC (default provided by Replit).
ISSUER_URL="https://replit.com/oidc"
